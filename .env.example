# Websites are auto-discovered: every GA4 property the service account can read
# shows up in the switcher. Requires the Google Analytics Admin API to be enabled
# in the service account's Cloud project, plus Viewer access on each property.
#
# GA_PROPERTIES below is optional — use it to override display names, or as a
# fallback list if auto-discovery is unavailable.
GA_PROPERTIES=[{"id":"547222815","name":"Monza SAL","url":"monza.example"},{"id":"YOUR_OTHER_PROPERTY_ID","name":"Second Site","url":"example.com"}]

# Set to "false" to skip auto-discovery and use only the GA_PROPERTIES list above.
# GA_AUTO_DISCOVER=false

# Or single site fallback:
# GA_PROPERTY_ID=547222815
# GA_PROPERTY_NAME=Monza SAL

GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Password gate. When set, every page and API route requires this password
# (entered once at /login, stored in an httpOnly cookie for 30 days).
# Leave unset for no gate. Set in Vercel for production, not just here.
# DASHBOARD_PASSWORD=
